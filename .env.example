# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Client app URL — only this origin will be allowed
CLIENT_URL=http://localhost:3000
